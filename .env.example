# ── SUPABASE (Database & Auth) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OAUTH PROVIDERS (Configured ONLY in Supabase Dashboard / API) ──
# Note: You do NOT need OAuth secret keys in this Next.js .env file.
# Supabase securely manages the Client ID & Client Secret on its servers.
#
# 1. Google OAuth: Add Client ID & Secret in Supabase -> Auth -> Providers -> Google
#    Callback URL: https://<your-project-id>.supabase.co/auth/v1/callback
# 2. GitHub OAuth: Add Client ID & Secret in Supabase -> Auth -> Providers -> GitHub
#    Callback URL: https://<your-project-id>.supabase.co/auth/v1/callback

# ── AI ENGINE (OpenAI or OpenRouter) ────────────────────────
# Accepts OpenAI (sk-...) or OpenRouter (sk-or-v1-...)
OPENAI_API_KEY=your-api-key
# GEMINI_API_KEY=your-gemini-or-openrouter-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_EVAL_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Set to your Vercel production URL (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── YOUTUBE DATA API v3 (Roadmap video search) ─────────────────────────────
# Free tier: 10,000 units/day (~100 roadmap generations/day)
# Get key at: https://console.cloud.google.com → APIs → YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-data-api-v3-key

# ── UPLOADTHING (Resume Storage) ───────────────────────────
UPLOADTHING_TOKEN=your-uploadthing-token

# ── RAZORPAY (Payments & Subscriptions) ────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_PRO_PLAN_ID=plan_...
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── RESEND (Transactional Emails) ──────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@interviewai.app

