# ── SUPABASE (Database & Auth) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI ENGINE (OpenAI or OpenRouter) ────────────────────────
# Accepts OpenAI (sk-...) or OpenRouter (sk-or-v1-...)
OPENAI_API_KEY=your-api-key
# GEMINI_API_KEY=your-gemini-or-openrouter-key

# ── APP URL ────────────────────────────────────────────────
# Set to your Vercel production URL (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── UPLOADTHING (Resume Storage) ───────────────────────────
UPLOADTHING_TOKEN=your-uploadthing-token

# ── RAZORPAY (Payments & Subscriptions) ────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_PRO_PLAN_ID=plan_...
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── RESEND (Transactional Emails) ──────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@interviewai.app

